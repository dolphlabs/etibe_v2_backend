# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/etibe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Security
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000
