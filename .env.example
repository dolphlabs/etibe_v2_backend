
# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/etibe

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=info

SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_COOKIE_NAME=etibe_session

MASTER_ENCRYPTION_KEY=your-32-character-minimum-master-key


# Network: "testnet" or "mainnet"
NEAR_NETWORK_ID=testnet

NEAR_MASTER_ACCOUNT_ID=etibe.testnet

NEAR_MASTER_PRIVATE_KEY=

NEAR_CONTRACT_ID=etibe.testnet

RESEND_API_KEY=

RESEND_FROM_EMAIL=noreply@etibe.app
RESEND_FROM_NAME=Etibé

# Base Chain Configuration
# Network: "mainnet" or "sepolia"
BASE_NETWORK=sepolia
BASE_RPC_URL=https://sepolia.base.org
BASE_MASTER_PRIVATE_KEY=
BASE_PAYOUT_CONTRACT_ADDRESS=

NOMBA_API_URL=https://sandbox.nomba.com
NOMBA_CLIENT_ID=your-nomba-client-id
NOMBA_CLIENT_SECRET=your-nomba-client-secret
NOMBA_ACCOUNT_ID=your-nomba-corporate-account-id
NOMBA_WEBHOOK_SECRET=your-webhook-verification-signing-key

# Paycrest API configuration
PAYCREST_API_URL=https://api.paycrest.io/v2
PAYCREST_API_KEY=your-paycrest-sender-api-key
PAYCREST_PARTNER_ID=your-paycrest-partner-id
