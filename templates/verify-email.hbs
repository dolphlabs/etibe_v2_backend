<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Verify Your Email - Etibé</title>
    <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
    <style>
      @import
      url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
      * { margin: 0; padding: 0; box-sizing: border-box; } body { font-family:
      'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen,
      Ubuntu, sans-serif; line-height: 1.6; color: #212121; background-color:
      #F5F5F5; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing:
      grayscale; } .email-wrapper { max-width: 600px; margin: 0 auto; padding:
      40px 20px; } .email-container { background-color: #FFFFFF; border-radius:
      16px; box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08); overflow: hidden; }
      .email-header { padding: 40px 40px 24px; text-align: center; } .logo {
      font-size: 32px; font-weight: 700; color: #4CAF50; letter-spacing: -0.5px;
      } .tagline { font-size: 13px; color: #666666; margin-top: 4px;
      letter-spacing: 1px; text-transform: uppercase; } .email-body { padding: 0
      40px 32px; } .greeting { font-size: 24px; font-weight: 600; color:
      #212121; margin-bottom: 12px; line-height: 1.3; } .message { font-size:
      16px; color: #424242; margin-bottom: 24px; line-height: 1.6; } .otp-card {
      background: linear-gradient(135deg, #4CAF50 0%, #45A049 100%);
      border-radius: 12px; padding: 32px; text-align: center; margin-bottom:
      24px; } .otp-label { font-size: 13px; color: rgba(255, 255, 255, 0.9);
      margin-bottom: 12px; text-transform: uppercase; letter-spacing: 2px; }
      .otp-code { font-size: 42px; font-weight: 700; color: #FFFFFF;
      letter-spacing: 8px; font-family: 'SF Mono', 'Monaco', 'Inconsolata',
      'Roboto Mono', monospace; } .expiry-notice { background-color: #FFF8E1;
      border-radius: 8px; padding: 16px; border-left: 4px solid #FFC107;
      margin-bottom: 24px; } .expiry-notice p { font-size: 14px; color: #424242;
      margin: 0; } .security-note { font-size: 14px; color: #666666;
      line-height: 1.6; } .email-footer { padding: 24px 40px; border-top: 1px
      solid #EEEEEE; text-align: center; } .footer-text { font-size: 12px;
      color: #9E9E9E; line-height: 1.6; } .social-links { margin-top: 16px; }
      .social-link { display: inline-block; width: 32px; height: 32px; margin: 0
      8px; background-color: #F5F5F5; border-radius: 50%; line-height: 32px;
      text-decoration: none; color: #666666; font-size: 14px; } @media only
      screen and (max-width: 600px) { .email-wrapper { padding: 20px 16px; }
      .email-header, .email-body, .email-footer { padding-left: 24px;
      padding-right: 24px; } .greeting { font-size: 20px; } .message {
      font-size: 15px; } .otp-code { font-size: 32px; letter-spacing: 6px; }
      .otp-card { padding: 24px; } }
    </style>
  </head>
  <body>
    <div class="email-wrapper">
      <div class="email-container">
        <!-- Header -->
        <div class="email-header">
          <div class="logo">Etibé</div>
          <div class="tagline">decentralised Social Savings</div>
        </div>

        <!-- Body -->
        <div class="email-body">
          <!-- Greeting -->
          <h1 class="greeting">
            Welcome{{#if firstName}}, {{firstName}}{{/if}}! 👋
          </h1>

          <!-- Message -->
          <p class="message">
            You're just one step away from joining the future of community
            savings. Enter this verification code to confirm your email and
            unlock your secure NEAR wallet:
          </p>

          <!-- OTP Card -->
          <div class="otp-card">
            <div class="otp-label">Verification Code</div>
            <div class="otp-code">{{otp}}</div>
          </div>

          <!-- Expiry Notice -->
          <div class="expiry-notice">
            <p>
              ⏱️ This code expires in
              <strong>{{expiryMinutes}} minutes</strong>. Don't share it with
              anyone — our team will never ask for it.
            </p>
          </div>

          <!-- Security Note -->
          <p class="security-note">
            If you didn't create an account with Etibé, you can safely ignore
            this email. Someone may have entered your email by mistake.
          </p>
        </div>

        <!-- Footer -->
        <div class="email-footer">
          <p class="footer-text">
            ©
            {{year}}
            Etibé. Built on NEAR Protocol.<br />
            Empowering communities through decentralised trust.
          </p>
          <div class="social-links">
            <a
              href="https://twitter.com/etibe_app"
              class="social-link"
              title="Twitter"
            >𝕏</a>
            <a
              href="https://discord.gg/etibe"
              class="social-link"
              title="Discord"
            >💬</a>
            <a
              href="https://etibe.app"
              class="social-link"
              title="Website"
            >🌐</a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>