{
  "name": "etibe-api",
  "version": "1.0.0",
  "description": "Enterprise Grade NestJS API with Fastify and MongoDB",
  "author": "Etibé Team",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "docker:build": "docker build -t etibe-api .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/secure-session": "^8.3.0",
    "@fastify/session": "^11.1.1",
    "@near-js/transactions": "^2.5.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.1.11",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.44.0",
    "bs58": "^6.0.0",
    "bullmq": "^5.66.4",
    "cache-manager": "^7.2.7",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cloudinary": "^2.9.0",
    "fastify": "^5.6.2",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.2",
    "js-sha256": "^0.11.1",
    "mongoose": "^9.1.1",
    "nanoid": "^5.1.6",
    "near-api-js": "^6.5.1",
    "nestjs-pino": "^4.5.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.6.0",
    "rxjs": "^7.8.2",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "xss-filters": "^1.2.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@types/argon2": "^0.15.4",
    "@types/node": "^25.0.3",
    "@types/xss-filters": "^1.2.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
